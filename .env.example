# ──────────────────────────────────────────────────────────────────────────────
# CyberGram environment configuration
# Copy to `.env.local` for development. In production, inject these through your
# platform's secret manager — never commit real values.
# ──────────────────────────────────────────────────────────────────────────────

# Public origin of the app (no trailing slash). Must be https:// in production.
APP_URL=http://localhost:3000

# 32+ random bytes. Signs email-preference links and private file URLs.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=

# ── Database ─────────────────────────────────────────────────────────────────
# Leave empty to run on embedded Postgres (PGlite, stored in ./.data) — zero
# install, intended for local development only.
# Production: postgres://user:password@host:5432/cybergram?sslmode=require
DATABASE_URL=
DATABASE_POOL_MAX=10

# ── OAuth (optional; the buttons only appear when configured) ────────────────
# Callback URLs: {APP_URL}/api/auth/github/callback and {APP_URL}/api/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email ────────────────────────────────────────────────────────────────────
# Without SMTP_URL, development mail is written to ./.data/outbox and shown at
# /dev/outbox. Production refuses to start sending without it.
SMTP_URL=
EMAIL_FROM="CyberGram <no-reply@example.com>"

# ── Redis (optional) ─────────────────────────────────────────────────────────
# Enables distributed rate limiting across instances. Falls back to in-memory.
REDIS_URL=

# ── File storage ─────────────────────────────────────────────────────────────
# local  → ./.data/uploads (development)
# s3     → any S3-compatible store (AWS S3, Cloudflare R2, MinIO, …)
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Malware scanning ─────────────────────────────────────────────────────────
# clamd host/port (INSTREAM protocol). When unset, uploads still pass type
# verification and static checks but are recorded as scan "skipped".
CLAMAV_HOST=
CLAMAV_PORT=3310
# Set true in production to reject uploads when the scanner is unreachable.
UPLOAD_REQUIRE_SCAN=false

# ── Scheduled work ───────────────────────────────────────────────────────────
# Bearer token required by POST /api/cron/daily (job sync, expiry, alerts).
CRON_SECRET=
# The built-in scheduler checks every 15 minutes for job sources that are due, so
# listings refresh with no extra setup. Set to false when an external scheduler
# calls /api/cron/daily, or when running several instances.
ENABLE_INTERNAL_SCHEDULER=true

# ── Security ─────────────────────────────────────────────────────────────────
# Number of reverse proxies you control in front of the app (used to read the real client IP).
TRUSTED_PROXY_HOPS=1
# Reject passwords found in known breaches (k-anonymity lookup; password never leaves the server).
HIBP_CHECK=true

# ── Seed accounts (npm run db:seed) ──────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@cybergram.local
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=
